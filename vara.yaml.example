vara:
  port: 7842
  open_browser: true
  log_level: info
  cors_origins: []

backends:
  - name: local-qdrant
    type: qdrant
    host: localhost
    port: 6333
    grpc_port: 6334
    prefer_grpc: false
    default_collection: documents

